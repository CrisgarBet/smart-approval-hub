{
  "swagger": "2.0",
  "info": { "title": "Smart Approval Hub Demo", "description": "API dedicada para una Canvas App de demostración. Reutiliza el dominio real de solicitudes de compra.", "version": "1.0.0" },
  "host": "POWER_APPS_PUBLIC_HOST",
  "basePath": "/api/powerapps",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": { "api_key": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "Clave de demostración configurada como POWER_APPS_DEMO_KEY." } },
  "security": [{ "api_key": [] }],
  "paths": {
    "/health": { "get": { "operationId": "PowerAppsHealth", "summary": "Comprobar integración", "description": "Comprueba gateway, dominio y estado de integraciones. No requiere API key.", "x-ms-summary": "Estado de integración", "x-ms-visibility": "important", "security": [], "responses": { "200": { "description": "Estado actual", "schema": { "$ref": "#/definitions/IntegrationHealth" } } } } },
    "/requests": {
      "get": { "operationId": "ListRequests", "summary": "Listar solicitudes", "description": "Obtiene una colección estable bajo la propiedad items.", "x-ms-summary": "Listar solicitudes", "x-ms-visibility": "important", "parameters": [{ "name": "status", "in": "query", "required": false, "type": "string", "enum": ["PENDIENTE", "APROBADA", "RECHAZADA"], "x-ms-summary": "Estado" }, { "name": "search", "in": "query", "required": false, "type": "string", "x-ms-summary": "Búsqueda" }], "responses": { "200": { "description": "Colección obtenida", "schema": { "$ref": "#/definitions/PurchaseRequestList" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } },
      "post": { "operationId": "CreateRequest", "summary": "Crear solicitud", "description": "Crea una solicitud y ejecuta la regla de aprobación automática.", "x-ms-summary": "Crear solicitud", "x-ms-visibility": "important", "parameters": [{ "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/CreateRequest" } }], "responses": { "201": { "description": "Solicitud creada", "schema": { "$ref": "#/definitions/PurchaseRequest" } }, "400": { "description": "Datos inválidos", "schema": { "$ref": "#/definitions/Error" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } }
    },
    "/requests/{id}": { "get": { "operationId": "GetRequest", "summary": "Obtener solicitud", "description": "Consulta una solicitud por UUID.", "x-ms-summary": "Obtener solicitud", "x-ms-visibility": "important", "parameters": [{ "$ref": "#/parameters/RequestId" }], "responses": { "200": { "description": "Solicitud encontrada", "schema": { "$ref": "#/definitions/PurchaseRequest" } }, "404": { "description": "No encontrada", "schema": { "$ref": "#/definitions/Error" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } } },
    "/requests/{id}/approve": { "patch": { "operationId": "ApproveRequest", "summary": "Aprobar solicitud", "description": "Aprueba una solicitud pendiente.", "x-ms-summary": "Aprobar solicitud", "x-ms-visibility": "important", "parameters": [{ "$ref": "#/parameters/RequestId" }, { "name": "body", "in": "body", "required": false, "schema": { "$ref": "#/definitions/ApproveRequest" } }], "responses": { "200": { "description": "Solicitud aprobada", "schema": { "$ref": "#/definitions/PurchaseRequest" } }, "409": { "description": "Ya tiene decisión final", "schema": { "$ref": "#/definitions/Error" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } } },
    "/requests/{id}/reject": { "patch": { "operationId": "RejectRequest", "summary": "Rechazar solicitud", "description": "Rechaza una solicitud pendiente con comentario obligatorio.", "x-ms-summary": "Rechazar solicitud", "x-ms-visibility": "important", "parameters": [{ "$ref": "#/parameters/RequestId" }, { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/RejectRequest" } }], "responses": { "200": { "description": "Solicitud rechazada", "schema": { "$ref": "#/definitions/PurchaseRequest" } }, "400": { "description": "Comentario requerido", "schema": { "$ref": "#/definitions/Error" } }, "409": { "description": "Ya tiene decisión final", "schema": { "$ref": "#/definitions/Error" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } } },
    "/metrics": { "get": { "operationId": "GetMetrics", "summary": "Obtener métricas", "description": "Obtiene conteos por estado y monto acumulado.", "x-ms-summary": "Consultar métricas", "x-ms-visibility": "important", "responses": { "200": { "description": "Métricas obtenidas", "schema": { "$ref": "#/definitions/Metrics" } }, "401": { "$ref": "#/responses/Unauthorized" }, "403": { "$ref": "#/responses/Forbidden" } } } }
  },
  "parameters": { "RequestId": { "name": "id", "in": "path", "required": true, "type": "string", "format": "uuid", "x-ms-summary": "Identificador" } },
  "responses": { "Unauthorized": { "description": "Falta la API key", "schema": { "$ref": "#/definitions/Error" } }, "Forbidden": { "description": "API key incorrecta", "schema": { "$ref": "#/definitions/Error" } } },
  "definitions": {
    "IntegrationHealth": { "type": "object", "required": ["status", "apiGateway", "domainService", "customConnector", "powerAutomate", "endpoint"], "properties": { "status": { "type": "string", "example": "ok" }, "apiGateway": { "type": "boolean", "example": true }, "domainService": { "type": "boolean", "example": true }, "customConnector": { "type": "string", "example": "PREPARADO" }, "powerAutomate": { "type": "string", "enum": ["SIMULADO", "CONFIGURADO"] }, "endpoint": { "type": "string", "example": "/api/powerapps" } } },
    "CreateRequest": { "type": "object", "required": ["requesterName", "requesterEmail", "concept", "description", "amount", "costCenter"], "properties": { "requesterName": { "type": "string", "example": "Cristian García" }, "requesterEmail": { "type": "string", "format": "email", "example": "correo@ejemplo.com" }, "concept": { "type": "string", "example": "Equipo de desarrollo" }, "description": { "type": "string", "example": "Compra de computador" }, "amount": { "type": "number", "format": "double", "minimum": 0.01, "example": 2500000 }, "costCenter": { "type": "string", "example": "TECNOLOGÍA" } } },
    "ApproveRequest": { "type": "object", "properties": { "comment": { "type": "string", "example": "Aprobada desde Power Apps" } } },
    "RejectRequest": { "type": "object", "required": ["rejectionComment"], "properties": { "rejectionComment": { "type": "string", "example": "Fuera del presupuesto" } } },
    "PurchaseRequest": { "allOf": [{ "$ref": "#/definitions/CreateRequest" }, { "type": "object", "required": ["id", "status", "createdAt", "updatedAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "status": { "type": "string", "enum": ["PENDIENTE", "APROBADA", "RECHAZADA"] }, "decisionComment": { "type": "string", "x-nullable": true }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } }] },
    "PurchaseRequestList": { "type": "object", "required": ["items", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/PurchaseRequest" } }, "total": { "type": "integer", "format": "int32", "example": 1 } } },
    "Metrics": { "type": "object", "required": ["total", "pending", "approved", "rejected", "totalAmount"], "properties": { "total": { "type": "integer", "format": "int64" }, "pending": { "type": "integer", "format": "int64" }, "approved": { "type": "integer", "format": "int64" }, "rejected": { "type": "integer", "format": "int64" }, "totalAmount": { "type": "number", "format": "double" } } },
    "Error": { "type": "object", "properties": { "statusCode": { "type": "integer" }, "message": { "type": "string" } } }
  }
}
